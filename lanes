import cv2 as cv
import numpy as np
from collections import deque

# История последних 10 кадров чтобы линии не пропадали
_left_history  = deque(maxlen=10)
_right_history = deque(maxlen=10)

def canny(img):
    gray = cv.cvtColor(img, cv.COLOR_BGR2GRAY)
    blur = cv.GaussianBlur(gray, (5, 5), 0)
    return cv.Canny(blur, 50, 150)

def make_coordinates(image, line_parameters):
    slope, intercept = line_parameters
    y1 = image.shape[0]
    y2 = int(y1 * (3 / 5))
    x1 = int((y1 - intercept) / slope)
    x2 = int((y2 - intercept) / slope)
    return np.array([x1, y1, x2, y2])

def average_slope_intercept(image, lines):
    left_fit  = []
    right_fit = []

    if lines is None:
        # Линии не найдены берём из истории
        left_line  = np.mean(_left_history,  axis=0).astype(int) if _left_history  else None
        right_line = np.mean(_right_history, axis=0).astype(int) if _right_history else None
        return _build_result(left_line, right_line)

    height, width = image.shape[:2]
    center_x = width // 2

    for line in lines:
        x1, y1, x2, y2 = line.reshape(4)

        if x2 == x1:
            continue

        parameters = np.polyfit((x1, x2), (y1, y2), 1)
        slope     = parameters[0]
        intercept = parameters[1]

        # Фильтр по углу отсекаем горизонтальные и слишком вертикальные
        if abs(slope) < 0.4 or abs(slope) > 3.5:
            continue

        mid_x = (x1 + x2) / 2

        if slope < 0 and mid_x < center_x:
            left_fit.append((slope, intercept))
        elif slope > 0 and mid_x > center_x:
            right_fit.append((slope, intercept))

    # Строим линии и добавляем в историю
    left_line  = None
    right_line = None

    if left_fit:
        left_avg  = np.average(left_fit, axis=0)
        left_line = make_coordinates(image, left_avg)
        _left_history.append(left_line)
    elif _left_history:
        # Не нашли используем среднее из истории
        left_line = np.mean(_left_history, axis=0).astype(int)

    if right_fit:
        right_avg  = np.average(right_fit, axis=0)
        right_line = make_coordinates(image, right_avg)
        _right_history.append(right_line)
    elif _right_history:
        right_line = np.mean(_right_history, axis=0).astype(int)

    return _build_result(left_line, right_line)

def _build_result(left_line, right_line):
    result = []
    if left_line  is not None: result.append(left_line)
    if right_line is not None: result.append(right_line)
    return np.array(result) if result else None

def display_lines(image, lines):
    line_image = np.zeros_like(image)
    if lines is not None:
        for line in lines:
            x1, y1, x2, y2 = line
            cv.line(line_image, (x1, y1), (x2, y2), (255, 255, 255), 15)
    return line_image

def fill_lane(image, lines):
    """Заливает зелёным область между двумя линиями полосы"""
    if lines is None or len(lines) < 2:
        return image

    left  = lines[0]
    right = lines[1]

    # Четыре точки трапеции между линиями
    pts = np.array([
        [left[0],  left[1]],   # низ левой
        [left[2],  left[3]],   # верх левой
        [right[2], right[3]],  # верх правой
        [right[0], right[1]],  # низ правой
    ], dtype=np.int32)

    overlay = image.copy()
    cv.fillPoly(overlay, [pts], (0, 255, 0))  #зелёный

    # Прозрачность 25% полупрозрачная заливка
    return cv.addWeighted(overlay, 0.25, image, 0.75, 0)

def mask(image):
    height, width = image.shape[:2]
    polygons = np.array([
        (int(width * 0.10), height),
        (int(width * 0.45), int(height * 0.60)),
        (int(width * 0.55), int(height * 0.60)),
        (int(width * 0.90), height),
    ])
    mask = np.zeros_like(image)
    cv.fillPoly(mask, np.array([polygons], dtype=np.int64), 255)
    return cv.bitwise_and(image, mask)
